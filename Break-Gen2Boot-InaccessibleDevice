<#
  Break-Gen2Boot-InaccessibleDevice.ps1
  Scenario: Kernel Panic / INACCESSIBLE_BOOT_DEVICE BSOD (Gen 2)
  Strategy: Asynchronous Storage Driver Disablement via Offline Registry Hive
#>

$ErrorActionPreference = 'Stop'

# 1. Clear OOBE Barrier immediately
Get-Process -Name "UserOOBEBroker" -ErrorAction SilentlyContinue | Stop-Process -Force

# 2. DEFINE THE REGISTRY MUTATION PAYLOAD
$breakScript = @"
Start-Sleep -Seconds 60

# Mount the SYSTEM registry hive to modify boot drivers out-of-process
reg.exe load HKLM\OFFLINE_SYSTEM C:\Windows\System32\config\SYSTEM

# Disable core virtual storage and cloud block storage initialization drivers
# Setting 'Start' to 4 completely disables the driver from loading during boot.
reg.exe add "HKLM\OFFLINE_SYSTEM\ControlSet001\Services\stornvme" /v Start /t REG_DWORD /d 4 /f
reg.exe add "HKLM\OFFLINE_SYSTEM\ControlSet001\Services\storvsc" /v Start /t REG_DWORD /d 4 /f
reg.exe add "HKLM\OFFLINE_SYSTEM\ControlSet001\Services\vhdmp" /v Start /t REG_DWORD /d 4 /f
reg.exe add "HKLM\OFFLINE_SYSTEM\ControlSet001\Services\spaceport" /v Start /t REG_DWORD /d 4 /f

# Unmount the hive cleanly so it commits to disk
reg.exe unload HKLM\OFFLINE_SYSTEM

# Force a violent reboot
& cmd.exe /c "shutdown /r /f /t 5"
"@

# 3. SAVE PAYLOAD TO LOCAL DISK
$scriptPath = "C:\Windows\Temp\StorageMutation.ps1"
Set-Content -Path $scriptPath -Value $breakScript

# 4. REGISTER THE BACKGROUND TASK
$action = New-ScheduledTaskAction -Execute "PowerShell.exe" -Argument "-NoProfile -ExecutionPolicy Bypass -File $scriptPath"
$trigger = New-ScheduledTaskTrigger -Once -At ((Get-Date).AddMinutes(1))
$principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -RunLevel Highest

Register-ScheduledTask -TaskName "AzureStorageBreak" -Action $action -Trigger $trigger -Principal $principal -Force

Write-Output "Asynchronous storage mutation scheduled. Reporting success to Azure..."
exit 0
